[Unit]
Description=fwauto - Linux Firewall Automation Tool
After=network.target ufw.service

[Service]
ExecStart=/usr/local/bin/fwauto monitor
Environment=PYTHONUNBUFFERED=1
# the journal stream never ends on its own, so restart on any exit
Restart=always
RestartSec=3
# needs root for ufw, but nothing outside the firewall config and its own db
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/ufw /var/lib/fwauto /run

[Install]
WantedBy=multi-user.target
